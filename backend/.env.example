# =============================================================================
# WarrantyHub — Backend Environment Configuration Template
# Phase 4: Backend Authentication
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the backend directory: cp .env.example .env
# 2. Fill in your actual Supabase PostgreSQL credentials and JWT secret.
# 3. DO NOT commit .env into version control (it is ignored by .gitignore).
# =============================================================================

# PostgreSQL / Supabase Database Connection
# Replace YOUR_HOST with your Supabase database host (e.g. db.bfogwrprtsfvsgmbzvdp.supabase.co)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.bfogwrprtsfvsgmbzvdp.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_actual_database_password_here

# JWT Authentication Secret (Must be a 256+ bit base64 or hex secret)
JWT_SECRET=your_secure_256_bit_random_jwt_secret_key_here

# Server Configuration
SERVER_PORT=8080
